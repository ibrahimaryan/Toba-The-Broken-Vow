MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1677135847}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0c773781156ce8842bf3d75b66053688, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Chapter4StoryManager
  npcGameObject: {fileID: 1660690760}
  npcPostAxePoint: {fileID: 75302300}
  npcHutPoint: {fileID: 1577599745}
  postAxeDialogue:
    lines:
    - characterName: Samosir
      sentence: Sebenarnya kamu siapa?? Kenapa bisa mengerti misteri di tempat semacam
        ini??
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Sudah kubilang nak. Aku hanya seorang penjaga.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Penjaga dari apa yang telah dilupakan oleh waktu.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Samosir
      sentence: Kepalakuuuu......
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: "Nakk\u2026 Keluarlah dari tempat ini, dan pastikan bawa pulang kayu
        dan batu..."
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Lalu temui aku, ada yang perlu aku berikan padamu nanti.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  crossDialogue:
    lines:
    - characterName: Samosir
      sentence: Ini tanda silang apa ya?? Emm aku perlu mencari kayu dan batu dulu..
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  pickaxeApproachDialogue:
    lines:
    - characterName: Samosir
      sentence: ' Eh apa itu ada alat pemecah batu'
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  postDigDialogue:
    lines:
    - characterName: Samosir
      sentence: Ada kunci bambu?? Seperti pernah melihatnya.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Samosir
      sentence: "Arghhh kepalaku\u2026"
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Samosir
      sentence: Aaa Akuu mulai ingat sedikit demi sedikit siapa akuu, aku yang sudah
        memakan bekal itu
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Samosir
      sentence: dan aku masih belum paham dulu tempat tinggalku tidak dikelilingi
        danau.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  missingItemsDialogue:
    lines:
    - characterName: Samosir
      sentence: Kekk.. Aku sudah mengumpulkan barang yang kamu minta, ini dia
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: kayu atau batu tidak cukup untukku membuat sebuah barang nakk...
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  handoverDialogue:
    lines:
    - characterName: Samosir
      sentence: Kekk.. Aku sudah mengumpulkan barang yang kamu minta, ini dia
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Bagus nak, kamu penurut ya??
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Memang itu yang harusnya kamu lakukan. Ini aku beri kamu sebuah cangkul
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  cangkulReceivedDialogue:
    lines:
    - characterName: Samosir
      sentence: Hahh?? Apa maksudnya diberi cangkul. Apa ada kaitannya dengan tanda
        aneh tadi ya?
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  woodRequired: 10
  stoneRequired: 10
  crossGameObject: {fileID: 1094386662}
  pickaxePickupGameObject: {fileID: 98491272}
  interactionDistance: 2
  getCangkulPanel: {fileID: 1745574340}
  getTreasurePanel: {fileID: 1796648203}
  getBambooKeyPanel: {fileID: 1317130786}
  digAnimationTrigger: dig
  delayBetweenDigHits: 0.5
