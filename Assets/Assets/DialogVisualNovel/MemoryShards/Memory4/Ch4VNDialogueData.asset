  lines:
  - speaker: {fileID: 11400000, guid: e1ec41e8e71a4c54c96dbeacd10704cb, type: 2}
    text: Samosir! Mana bekal yang diperintahkan ibumu?! Ayah sudah seharian membongkar
      tanah ini tanpa makan! Kau malah bermain-main!
    isPrologueCenterText: 0
    emotion: 1
    position: 0
    backgroundOverride: {fileID: -8911423472110217524, guid: fa47d5a438e88634ca4d45ad29038261, type: 3}
    sfxClip: {fileID: 0}
    waitForAudio: 0
    isAutoPlay: 0
    autoPlayDelay: 0
  - speaker: {fileID: 11400000, guid: 5a317f8e905122e4b80de0d576f24bde, type: 2}
    text: 'Maaf, Ayah... Samosir sangat lapar di jalan... Bekalnya... hanya tersisa
      sedikit... '
    isPrologueCenterText: 0
    emotion: 5
    position: 2
    backgroundOverride: {fileID: -8911423472110217524, guid: fa47d5a438e88634ca4d45ad29038261, type: 3}
    sfxClip: {fileID: 0}
    waitForAudio: 0
    isAutoPlay: 0
    autoPlayDelay: 0
  - speaker: {fileID: 11400000, guid: e1ec41e8e71a4c54c96dbeacd10704cb, type: 2}
    text: Anak tidak tahu diuntung! Dasar anak kurang ajar! Tidak tahu dibilangi,
      keras kepala! Memang benar kata orang, kau ini... DASAR ANAK IKAN!!
    isPrologueCenterText: 0
    emotion: 2
    position: 0
    backgroundOverride: {fileID: -8911423472110217524, guid: fa47d5a438e88634ca4d45ad29038261, type: 3}
    sfxClip: {fileID: 0}
    waitForAudio: 0
    isAutoPlay: 0
    autoPlayDelay: 0
  - speaker: {fileID: 0}
    text: 
    isPrologueCenterText: 0
    emotion: 0
    position: 0
    backgroundOverride: {fileID: -2086832803264746168, guid: a47efa86e9890e94cb7e93e18aa70ae3, type: 3}
    sfxClip: {fileID: 8300000, guid: 8c73fee311d2bfa4ba92335a7fce6940, type: 3}
    waitForAudio: 1
    isAutoPlay: 0
    autoPlayDelay: 0
  - speaker: {fileID: 11400000, guid: e1ec41e8e71a4c54c96dbeacd10704cb, type: 2}
    text: "T-tunggu... apa yang telah kuucapkan? Putri... maafkan aku! Aku tidak
      bermaksud\u2014"
    isPrologueCenterText: 0
    emotion: 3
    position: 1
    backgroundOverride: {fileID: -8911423472110217524, guid: fa47d5a438e88634ca4d45ad29038261, type: 3}
    sfxClip: {fileID: 0}
    waitForAudio: 0
    isAutoPlay: 0
    autoPlayDelay: 0
