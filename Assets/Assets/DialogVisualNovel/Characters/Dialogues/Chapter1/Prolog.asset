    waitForAudio: 1
    isAutoPlay: 0
    autoPlayDelay: 2
  - speaker: {fileID: 0}
    text: Ada janji yang tidak boleh diucapkan jika tak mampu ditepati
    isPrologueCenterText: 1
    emotion: 0
    position: 0
    backgroundOverride: {fileID: -2086832803264746168, guid: a47efa86e9890e94cb7e93e18aa70ae3, type: 3}
    sfxClip: {fileID: 0}
    waitForAudio: 0
    isAutoPlay: 0
    autoPlayDelay: 2
  - speaker: {fileID: 0}
    text: Dan ada rahasia yang harus dibawa mati, demi keselamatan bumi.
    isPrologueCenterText: 1
    emotion: 0
    position: 0
    backgroundOverride: {fileID: -2086832803264746168, guid: a47efa86e9890e94cb7e93e18aa70ae3, type: 3}
    sfxClip: {fileID: 0}
    waitForAudio: 0
    isAutoPlay: 0
    autoPlayDelay: 2
  - speaker: {fileID: 0}
    text: Ini bukanlah kisah tentang kepahlawanan.
    isPrologueCenterText: 1
    emotion: 0
    position: 0
    backgroundOverride: {fileID: -2086832803264746168, guid: a47efa86e9890e94cb7e93e18aa70ae3, type: 3}
    sfxClip: {fileID: 0}
    waitForAudio: 0
    isAutoPlay: 0
    autoPlayDelay: 2
  - speaker: {fileID: 0}
    text: Ini adalah kisah tentang keserakahan, kelaparan, dan sumpah purba yang
      patah.
    isPrologueCenterText: 1
    emotion: 0
    position: 0
    backgroundOverride: {fileID: -2086832803264746168, guid: a47efa86e9890e94cb7e93e18aa70ae3, type: 3}
    sfxClip: {fileID: 0}
    waitForAudio: 0
    isAutoPlay: 0
    autoPlayDelay: 2
  - speaker: {fileID: 0}
    text: 
    isPrologueCenterText: 1
    emotion: 0
    position: 0
