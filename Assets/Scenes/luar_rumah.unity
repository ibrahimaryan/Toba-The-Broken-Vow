--- !u!114 &1300373098
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1300373097}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57328ec4dd08868448a0de4145140ef7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Chapter3StoryManager
  exitDialogue:
    lines:
    - characterName: Samosir
      sentence: Aku masih bingung apa yang kulakukan tadi, sepertinya aku perlu berjalan-jalan
        agar sedikit tenang..
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  exitDialogueFlag: chapter3_exit_dialogue_played
  objectiveTargetTransform: {fileID: 1372794142}
  npcGameObject: {fileID: 1660690760}
  npcDialogue:
    lines:
    - characterName: Opung
      sentence: Hai anak muda
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Samosir
      sentence: Iya kek, Anda siapa yaa??
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Aku hanya seorang penjaga, anak muda. Penjaga dari apa yang telah
        dilupakan oleh waktu.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Kau sedang mencari jalan pulang, atau mencari alasan kenapa kau di
        sini??
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Samosir
      sentence: Aku kehilangan ingatanku. Tapi setiap benda di daerah sini memicu
        bayangan masa lalu.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Jejak kaki di tanah kelahiran tidak pernah berbohong...
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: Jika kau merasa butuh sesuatu cek rantang yang usang...
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Opung
      sentence: di sana kau akan tahu rasa lapar yang menghancurkan segalanya.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
    - characterName: Samosir
      sentence: Baik kek...
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  explorationFlag: chapter3_player_explored_map
  npcSequenceFlag: chapter3_npc_sequence_played
  chapter3PuzzleTrigger: {fileID: 1572032628}
  npcFadeDuration: 1.2
