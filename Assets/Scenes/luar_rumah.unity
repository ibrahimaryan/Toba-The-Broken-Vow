      sentence: Akhirnya selesai juga.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  opungDialogue:
    lines:
    - characterName: Samosir
      sentence: Kekkk??
      isSpeechBubble: 1
      isCutsceneStyle: 0
