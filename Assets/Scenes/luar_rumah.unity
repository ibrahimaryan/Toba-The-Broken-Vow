      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  arrivalDialogue:
    lines:
    - characterName: Samosir
      sentence: Ada bambu yang mirip, tapi letaknya kok di dekat air ya. Coba aku
        pasang kunci bambu itu.
      isSpeechBubble: 1
      isCutsceneStyle: 0
      holdTime: 3
  successDialogue:
    lines:
